{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":gitSignOff",
    "helpers:pinGitHubActionDigests"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      // The go directive in go.mod is the minimum Go version required by
      // users of this library, don't bump it along with new Go releases.
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "groupName": "all go dependencies",
      "groupSlug": "all-go-deps",
      "matchManagers": [
        "gomod"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ]
    }
  ],
  "customManagers": [
    {
      // Manages the Go version used in CI, annotated with e.g.:
      //   # renovate: datasource=golang-version depName=go
      //   GO_VERSION: 1.27.3
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)\\s+.+_VERSION: (?<currentValue>.*)"
      ]
    }
  ]
}
